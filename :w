
use num_bigint::BigInt;

enum Op {
    Inp,
    Lit(BigInt),
    Add,
    Sub,
    Mul,
    Pow,
}

pub struct Polynomial(Vec<Op>);

impl Polynomial {
    fn eval(&self, input: BigInt) -> BigInt {
        let mut stack = Vec::new();
        for op in &self.0 {
            match op {
                Op::Inp    => stack.push(input.clone()),
                Op::Lit(n) => stack.push(n.clone()),

                Op::Add => {
                    if let Some(op0) = stack.pop() {
                        if let Some(op1) = stack.pop() {
                            stack.push(op1 + op0);
                        } else {
                            stack.push(op0);
                        }
                    } else {
                        stack.push(BigInt::from(0));
                    }

                },
                Op::Sub => todo!(),
                Op::Mul => todo!(),
                Op::Pow => todo!(),
            }
        }
        todo!()
    }

